#!/usr/bin/env bash
# agent-makemkv - Rip DVDs and Blu-rays to MKV via MakeMKV's headless CLI (makemkvcon)
#
# Wraps makemkvcon "robot mode" (-r), whose structured output is purpose-built
# for automation. Follows the universal Connect -> Snapshot -> Interact -> Verify:
#   drives   -> enumerate optical drives          (Connect)
#   info     -> scan a disc, list titles          (Snapshot)
#   rip      -> rip selected titles to .mkv        (Interact)
#   backup   -> full decrypted disc backup         (Interact)
#   stream   -> DLNA/UPnP streaming server         (Interact)
#   verify   -> confirm output .mkv files exist    (Verify)
#   snapshot -> drives + version + reg state JSON

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -f "$REPO_ROOT/lib/json-output.sh" ]]; then
    # shellcheck source=lib/json-output.sh
    source "$REPO_ROOT/lib/json-output.sh"
fi

OUTPUT_FORMAT="${OUTPUT_FORMAT:-text}"
DRY_RUN=false
MINLENGTH=120   # ignore titles shorter than this many seconds (default MakeMKV skips clutter)

show_help() {
    cat << 'EOF'
agent-makemkv - Rip DVDs and Blu-rays to MKV (wraps makemkvcon robot mode)

Commands:
  drives                                 List optical drives and loaded discs
  info <disc>                            Scan a disc; list titles (duration, size, chapters)
  scan <disc>                            Alias for info
  rip <disc> <title|all> <outdir>        Rip title(s) to MKV files in outdir
  backup <disc> <outdir>                 Full decrypted disc backup (Blu-ray/DVD)
  stream [disc]                          Start DLNA/UPnP streaming server (blocks)
  verify <outdir>                        List .mkv outputs in outdir with sizes
  version                                Show MakeMKV version
  snapshot                               Drives + version + registration state (JSON)

Disc argument:
  Accepts "disc:0", a bare index "0", "dev:/dev/rdisk2", "file:disc.iso", or "iso:/path".
  A bare integer N is normalized to disc:N. Defaults to disc:0 where omitted.

Options:
  --json                                 Structured JSON output
  --dry-run                              Print the makemkvcon command without running it
  --minlength <sec>                      Minimum title length for info/rip (default: 120)

Environment:
  AGENT_MAKEMKV_BIN                      Path to makemkvcon (else PATH, else MakeMKV.app)

Examples:
  agent-makemkv drives
  agent-makemkv info disc:0
  agent-makemkv info 0 --json
  agent-makemkv rip disc:0 all ~/rips
  agent-makemkv rip disc:0 3 ~/rips
  agent-makemkv backup disc:0 ~/backup --json
  agent-makemkv verify ~/rips
  agent-makemkv snapshot
EOF
}

die() { json_error "$1" "${2:-1}"; exit "${2:-1}"; }

# Resolve the makemkvcon binary: explicit override, then PATH, then the macOS app bundle.
resolve_bin() {
    if [[ -n "${AGENT_MAKEMKV_BIN:-}" ]]; then
        # Accept the override only if it is actually runnable (a path or a
        # command on PATH); otherwise treat it as unresolved.
        if [[ -x "$AGENT_MAKEMKV_BIN" ]] || command -v "$AGENT_MAKEMKV_BIN" &>/dev/null; then
            echo "$AGENT_MAKEMKV_BIN"; return 0
        fi
        return 1
    fi
    if command -v makemkvcon &>/dev/null; then
        command -v makemkvcon; return 0
    fi
    local app="/Applications/MakeMKV.app/Contents/MacOS/makemkvcon"
    [[ -x "$app" ]] && { echo "$app"; return 0; }
    return 1
}

# Normalize a user-supplied disc token into a makemkvcon source spec.
normalize_disc() {
    local d="${1:-disc:0}"
    if [[ "$d" =~ ^[0-9]+$ ]]; then
        echo "disc:$d"
    else
        echo "$d"
    fi
}

# Run makemkvcon (or echo it in --dry-run).
mkvcon() {
    local bin
    bin="$(resolve_bin)" || die "makemkvcon not found. Install MakeMKV or set AGENT_MAKEMKV_BIN." 127
    if $DRY_RUN; then
        printf '%s' "$bin"
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    "$bin" "$@"
}

# ---- Robot-output parser (shared by info/drives/snapshot/version) ----
# Parses makemkvcon -r output into JSON. mode=$1, raw robot text=$2.
# The raw text is passed via env (MKV_ROBOT_RAW) because the heredoc below
# occupies stdin.
parse_robot() {
    local mode="$1" raw="$2"
    MKV_ROBOT_RAW="$raw" python3 - "$mode" "$MINLENGTH" <<'PY'
import sys, os, json, csv, io

mode = sys.argv[1]
minlen = int(sys.argv[2])

# MakeMKV attribute ids we surface with friendly names (apdefs.h). Unknown ids
# are still kept, keyed by their numeric id, so nothing is silently dropped.
ATTR = {
    1: "type", 2: "name", 3: "lang_code", 4: "lang_name", 5: "codec_id",
    6: "codec_short", 7: "codec_long", 8: "chapter_count", 9: "duration",
    10: "disk_size", 11: "disk_size_bytes", 13: "bitrate", 19: "video_size",
    27: "output_filename", 28: "meta_lang_code", 29: "meta_lang_name",
    30: "tree_info", 31: "panel_title", 32: "volume_name", 33: "order_weight",
}

def fields(rest):
    # makemkvcon uses CSV with quoted strings that may contain commas.
    return next(csv.reader(io.StringIO(rest)))

drives, titles, disc, version = [], {}, {}, None

def attr_key(code):
    try:
        code = int(code)
    except ValueError:
        return str(code)
    return ATTR.get(code, f"attr_{code}")

for line in os.environ.get("MKV_ROBOT_RAW", "").splitlines():
    line = line.rstrip("\n")
    if ":" not in line:
        continue
    tag, rest = line.split(":", 1)
    try:
        f = fields(rest)
    except Exception:
        continue
    if tag == "MSG":
        # MSG:code,flags,count,message,format,param0,...  The version banner's
        # last parameter is the clean version ("MakeMKV v1.17.7 ..."); the
        # message field (f[3]) has a trailing " started".
        if version is None and len(f) >= 4 and "MakeMKV" in f[3]:
            version = f[-1] if "MakeMKV" in f[-1] else f[3]
    elif tag == "DRV":
        # DRV:index,visible,enabled,flags,drivename,discname,device
        if len(f) >= 7 and f[1] not in ("0", "256"):  # visible drive present
            drives.append({
                "index": int(f[0]) if f[0].isdigit() else f[0],
                "drive": f[4],
                "disc": f[5],
                "device": f[6],
                "loaded": bool(f[5]),
            })
    elif tag == "CINFO":
        # CINFO:id,code,value
        if len(f) >= 3:
            disc[attr_key(f[0])] = f[2]
    elif tag == "TINFO":
        # TINFO:title,id,code,value
        if len(f) >= 4:
            t = titles.setdefault(int(f[0]), {"index": int(f[0]), "attrs": {}})
            t["attrs"][attr_key(f[1])] = f[3]
    # SINFO (per-stream) is intentionally not expanded to keep output compact.

if mode == "drives":
    print(json.dumps({"drives": drives}, indent=2))
elif mode == "version":
    print(json.dumps({"version": version}, indent=2))
else:  # info / snapshot title scan
    out = []
    for idx in sorted(titles):
        a = titles[idx]["attrs"]
        # Filter sub-minlength titles when duration is known (HH:MM:SS).
        dur = a.get("duration", "")
        secs = None
        if dur and dur.count(":") == 2:
            hh, mm, ss = dur.split(":")
            try:
                secs = int(hh) * 3600 + int(mm) * 60 + int(ss)
            except ValueError:
                secs = None
        if secs is not None and secs < minlen:
            continue
        out.append({
            "index": idx,
            "name": a.get("name") or a.get("output_filename", ""),
            "duration": dur,
            "duration_secs": secs,
            "chapters": a.get("chapter_count", ""),
            "size": a.get("disk_size", ""),
            "size_bytes": a.get("disk_size_bytes", ""),
            "output_filename": a.get("output_filename", ""),
        })
    print(json.dumps({"disc": disc, "titles": out}, indent=2))
PY
}

cmd_drives() {
    local disc
    disc="$(normalize_disc "disc:9999")"  # out-of-range: enumerate then exit fast
    local raw
    if $DRY_RUN; then
        mkvcon -r --cache=1 info "$disc"; return 0
    fi
    raw="$(mkvcon -r --cache=1 info "$disc" 2>/dev/null || true)"
    local parsed
    parsed="$(parse_robot drives "$raw")"
    render_json_or_table "$parsed" drives
}

cmd_info() {
    local disc; disc="$(normalize_disc "${1:-disc:0}")"
    if $DRY_RUN; then
        mkvcon -r "--minlength=$MINLENGTH" info "$disc"; return 0
    fi
    local raw
    raw="$(mkvcon -r "--minlength=$MINLENGTH" info "$disc" 2>/dev/null || true)"
    [[ -z "$raw" ]] && die "No output from makemkvcon; is a disc loaded in $disc?"
    local parsed
    parsed="$(parse_robot info "$raw")"
    render_json_or_table "$parsed" info
}

cmd_rip() {
    local disc title outdir
    disc="$(normalize_disc "${1:?disc required}")"
    title="${2:?title index or 'all' required}"
    outdir="${3:?output directory required}"
    mkdir -p "$outdir"
    if $DRY_RUN; then
        mkvcon -r --progress=-same "--minlength=$MINLENGTH" mkv "$disc" "$title" "$outdir"
        return 0
    fi
    if mkvcon -r --progress=-same "--minlength=$MINLENGTH" mkv "$disc" "$title" "$outdir"; then
        # Verify: report what landed in outdir.
        cmd_verify "$outdir"
    else
        die "makemkvcon rip failed for $disc title $title"
    fi
}

cmd_backup() {
    local disc outdir
    disc="$(normalize_disc "${1:?disc required}")"
    outdir="${2:?output directory required}"
    mkdir -p "$outdir"
    if $DRY_RUN; then
        mkvcon -r --progress=-same --decrypt backup "$disc" "$outdir"; return 0
    fi
    if mkvcon -r --progress=-same --decrypt backup "$disc" "$outdir"; then
        json_success "Backup complete: $outdir"
    else
        die "makemkvcon backup failed for $disc"
    fi
}

cmd_stream() {
    local disc; disc="$(normalize_disc "${1:-disc:0}")"
    # stream blocks until interrupted; pass through directly.
    mkvcon -r stream "$disc"
}

cmd_version() {
    if $DRY_RUN; then
        mkvcon -r --cache=1 info "disc:9999"; return 0
    fi
    local raw parsed
    raw="$(mkvcon -r --cache=1 info "disc:9999" 2>/dev/null || true)"
    parsed="$(parse_robot version "$raw")"
    render_json_or_table "$parsed" version
}

cmd_verify() {
    local outdir="${1:?output directory required}"
    [[ -d "$outdir" ]] || die "Not a directory: $outdir"
    python3 - "$outdir" "$OUTPUT_FORMAT" <<'PY'
import sys, os, json
outdir, fmt = sys.argv[1], sys.argv[2]
files = []
for name in sorted(os.listdir(outdir)):
    if name.lower().endswith(".mkv"):
        p = os.path.join(outdir, name)
        sz = os.path.getsize(p)
        files.append({"file": name, "path": p, "size_bytes": sz,
                      "size_mb": round(sz / 1048576, 1)})
result = {"outdir": outdir, "count": len(files), "files": files}
if fmt == "json":
    print(json.dumps({"success": True, "result": result}, indent=2))
else:
    if not files:
        print(f"No .mkv files in {outdir}")
    else:
        for f in files:
            print(f"{f['size_mb']:>9.1f} MB  {f['file']}")
        print(f"\n{len(files)} file(s), {round(sum(x['size_bytes'] for x in files)/1048576,1)} MB total")
PY
}

cmd_snapshot() {
    # Compose snapshot from a single robot dump (drives + version).
    local dump
    dump="$(mkvcon -r --cache=1 info "disc:9999" 2>/dev/null || true)"
    local drives_json version_json
    drives_json="$(parse_robot drives "$dump")"
    version_json="$(parse_robot version "$dump")"
    python3 - "$OUTPUT_FORMAT" "$drives_json" "$version_json" <<'PY'
import sys, json
fmt, dj, vj = sys.argv[1], sys.argv[2], sys.argv[3]
snap = {
    "version": json.loads(vj).get("version"),
    "drives": json.loads(dj).get("drives", []),
}
if fmt == "json":
    print(json.dumps({"success": True, "result": snap}, indent=2))
else:
    print(f"MakeMKV: {snap['version'] or 'unknown'}")
    if not snap["drives"]:
        print("No optical drives detected.")
    for d in snap["drives"]:
        state = f"disc: {d['disc']}" if d["loaded"] else "empty"
        print(f"  [{d['index']}] {d['drive']}  ({state})  {d['device']}")
PY
}

# Render a parsed-JSON blob either as JSON or a compact human table.
render_json_or_table() {
    local parsed="$1" kind="$2"
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        json_result "$parsed"
        return 0
    fi
    MKV_PARSED="$parsed" python3 - "$kind" <<'PY'
import sys, os, json
kind = sys.argv[1]
data = json.loads(os.environ["MKV_PARSED"])
if kind == "drives":
    ds = data.get("drives", [])
    if not ds:
        print("No optical drives detected.")
    for d in ds:
        state = f"disc: {d['disc']}" if d["loaded"] else "empty"
        print(f"[{d['index']}] {d['drive']}  ({state})  {d['device']}")
elif kind == "version":
    print(data.get("version") or "unknown")
else:
    disc = data.get("disc", {})
    label = disc.get("name") or disc.get("volume_name") or "(unknown disc)"
    print(f"Disc: {label}")
    ts = data.get("titles", [])
    if not ts:
        print("No titles at or above the minimum length.")
    for t in ts:
        name = t["name"] or t["output_filename"] or f"title {t['index']}"
        print(f"  #{t['index']:>2}  {t['duration'] or '--:--:--'}  "
              f"{(t['chapters'] or '?')+'ch':>5}  {t['size'] or '?':>9}  {name}")
PY
}

# ---- Argument parsing (global flags may appear anywhere) ----
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --json) OUTPUT_FORMAT="json"; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --minlength) MINLENGTH="${2:?}"; shift 2 ;;
        --minlength=*) MINLENGTH="${1#*=}"; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

# Preflight: commands that shell out to makemkvcon must fail loudly if it is
# missing, rather than silently reporting "no drives" (some callers swallow
# stderr and non-zero exits via `|| true`).
case "$cmd" in
    drives|info|scan|rip|backup|stream|version|snapshot|snap)
        resolve_bin >/dev/null 2>&1 || \
            die "makemkvcon not found. Install MakeMKV or set AGENT_MAKEMKV_BIN." 127
        ;;
esac

case "$cmd" in
    drives)          cmd_drives "$@" ;;
    info|scan)       cmd_info "$@" ;;
    rip)             cmd_rip "$@" ;;
    backup)          cmd_backup "$@" ;;
    stream)          cmd_stream "$@" ;;
    verify)          cmd_verify "$@" ;;
    version)         cmd_version "$@" ;;
    snapshot|snap)   cmd_snapshot "$@" ;;
    ""|help)         show_help ;;
    *)               die "Unknown command: $cmd (try --help)" 2 ;;
esac
